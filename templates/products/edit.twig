{% extends "layout.twig" %}

{% block title %}商品編集{% endblock %}

{% block content %}
  <div class="container mt-5">
    <h2>✏️ 商品編集</h2>

    {% if productImages|length > 0 %}
      {% set mainImage = productImages[0] %}
      {% set mainThumb = 'thumb_' ~ mainImage.file_name %}
      {% set mainThumbPath = '/images/products/' ~ mainThumb|url_encode %}
      {% set mainThumbExists = imageFiles[mainThumb]|default(false) %}
      <div class="mb-4 text-center" id="main-image-display">
        <h5 class="mb-2">★ メイン画像</h5>
        {% if mainThumbExists %}
          <img src="{{ mainThumbPath }}" alt="メイン画像" class="main-thumbnail mx-auto d-block" id="main-image">
        {% else %}
          <div class="bg-secondary text-white py-4">No Image</div>
        {% endif %}
      </div>
    {% endif %}

    <form method="POST" action="{{ basePath }}/products/{{ product.id }}/update" enctype="multipart/form-data">
      {# 商品情報入力欄 #}
      <div class="mb-3">
        <label for="code" class="form-label">商品コード（半角英数字）</label>
        <input type="text" name="code" id="code" class="form-control"
               value="{{ product.code }}" required pattern="[A-Za-z0-9]+" maxlength="50" autocomplete="off">
      </div>

      <div class="mb-3">
        <label for="category_id" class="form-label">カテゴリ</label>
        <select name="category_id" id="category_id" class="form-select" required>
          {% for cat in categories %}
            {% set depth = cat.depth|default(0) %}
            {% set indent = '' %}
            {% for i in 1..depth %}
              {% set indent = indent ~ '　' %}
            {% endfor %}
            {% set prefix = depth > 0 ? '└ ' : '' %}
            <option value="{{ cat.id }}"
              {% if product.category_id == cat.id %}selected{% endif %}>
              {{ indent ~ prefix ~ cat.name }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="mb-3">
        <label for="name" class="form-label">商品名</label>
        <input type="text" name="name" id="name" class="form-control" value="{{ product.name }}" required>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">商品説明</label>
        <textarea name="description" id="description" class="form-control" rows="4">{{ product.description }}</textarea>
      </div>

      <div class="mb-3">
        <label for="price" class="form-label">価格</label>
        <input type="number" name="price" id="price" class="form-control" value="{{ product.price }}" required>
      </div>

      <div class="mb-3">
        <label for="cost_price" class="form-label">仕入価格</label>
        <input type="number" name="cost_price" id="cost_price" class="form-control"
               value="{{ product.cost_price }}" min="0" step="1" required>
      </div>

      <div class="mb-3">
        <label for="stock" class="form-label">在庫数</label>
        <input type="number" name="stock" id="stock" class="form-control" value="{{ product.stock }}" required>
      </div>

      {# スマホ専用：画像追加＋ボタン（上部） #}
      <div class="d-block d-md-none mb-3">
        <label for="new_images_top" class="form-label">画像を追加（最大10枚）</label>
        <input type="file" name="new_images[]" id="new_images_top" class="form-control" multiple accept="image/*">
        <div id="imageWarningTop" class="text-danger mt-2" style="display: none;">⚠️ 画像は最大10枚まで選択できます。</div>

        <div class="mt-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary flex-fill">更新する</button>
          <a href="{{ basePath }}/products" class="btn btn-secondary flex-fill">戻る</a>
        </div>
      </div>

      {% if productImages is not empty %}
        <div class="mb-3">
          <label class="form-label">登録済み画像（ドラッグで並び替え）</label>
          <div id="sortable-images" class="d-flex flex-wrap gap-3 sortable-container">
            {% for img in productImages %}
              {% set original = img.file_name %}
              {% set thumb = 'thumb_' ~ original %}
              {% set thumbPath = '/images/products/' ~ thumb|url_encode %}
              {% set originalPath = '/images/products/' ~ original|url_encode %}
              {% set thumbExists = imageFiles[thumb]|default(false) %}
              <div class="sortable-item text-center position-relative" data-id="{{ img.id }}">
                {% if loop.index0 == 0 %}
                  <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-warning">★</span>
                {% endif %}
                <a href="#" data-bs-toggle="modal" data-bs-target="#modal{{ img.id }}">
                  <img src="{{ thumbExists ? thumbPath : originalPath }}" class="img-thumbnail thumbnail">
                </a>
                <div class="form-check d-inline-flex align-items-center gap-1 mt-1">
                  <input class="form-check-input" type="checkbox" name="delete_images[]" value="{{ img.id }}" id="del{{ img.id }}">
                  <label class="form-check-label mb-0" for="del{{ img.id }}">削除</label>
                </div>
              </div>

              <div class="modal fade" id="modal{{ img.id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                  <div class="modal-content bg-transparent border-0">
                    <div class="modal-body text-center">
                      <img src="/images/products/{{ img.file_name }}" class="img-fluid">
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          <input type="hidden" name="sorted_image_ids" id="sorted_image_ids">
        </div>
      {% endif %}

      {# 通常表示：画像追加＋ボタン（下部） #}
      <div class="mb-3">
        <label for="new_images" class="form-label">画像を追加（最大10枚）</label>
        <input type="file" name="new_images[]" id="new_images" class="form-control" multiple accept="image/*">
        <div id="imageWarning" class="text-danger mt-2" style="display: none;">⚠️ 画像は最大10枚まで選択できます。</div>
      </div>

      <div class="d-flex gap-2 flex-wrap justify-content-start">
        <button type="submit" class="btn btn-primary px-4">更新する</button>
        <a href="{{ basePath }}/products" class="btn btn-secondary px-4">戻る</a>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

  <script>
    function validateImageInput(inputId, warningId) {
      const input = document.getElementById(inputId);
      const warning = document.getElementById(warningId);
      if (!input || !warning) return;

      input.addEventListener('change', function () {
        const maxImages = 10;
        if (this.files.length > maxImages) {
          warning.style.display = 'block';
          this.value = '';
        } else {
          warning.style.display = 'none';
        }
      });
    }

    validateImageInput('new_images', 'imageWarning');
    validateImageInput('new_images_top', 'imageWarningTop');

    function updateMainImage() {
      const firstImg = document.querySelector('#sortable-images > .sortable-item img');
      if (!firstImg) return;

      const src = firstImg.getAttribute('src');
      const mainImage = document.getElementById('main-image');
      if (mainImage && src) {
        mainImage.setAttribute('src', src);
      }

      document.querySelectorAll('#sortable-images .badge').forEach(b => b.remove());
      const badge = document.createElement('span');
      badge.className = 'position-absolute top-0 start-0 translate-middle badge rounded-pill bg-warning';
      badge.textContent = '★';
      firstImg.closest('.sortable-item').prepend(badge);
    }

    const sortable = new Sortable(document.getElementById('sortable-images'), {
      animation: 150,
      onEnd: function () {
        const ids = Array.from(document.querySelectorAll('#sortable-images > .sortable-item')).map(el => el.dataset.id);
        document.getElementById('sorted_image_ids').value = ids.join(',');
        updateMainImage();
      }
    });

    window.addEventListener('DOMContentLoaded', () => {
      const ids = Array.from(document.querySelectorAll('#sortable-images > .sortable-item')).map(el => el.dataset.id);
      document.getElementById('sorted_image_ids').value = ids.join(',');
      updateMainImage();
    });
  </script>
{% endblock %}
