{% extends "layout.twig" %}
{% import "_macros.twig" as macros %}
{# ✅ list.twig が描画されています #}

{% block title %}商品一覧{% endblock %}

{% block content %}
  {# ✅ ログアウト後のメッセージ表示 #}
  {% if message == 'logged_out' %}
    <div class="alert alert-info text-center">ログアウトしました</div>
  {% endif %}

  {# ✅ ページタイトルと操作ボタン #}
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-3 gap-2">
    <h2 class="mb-0">📦 商品一覧</h2>
    <div class="d-flex flex-wrap gap-2">
      {% if session.user_id is defined %}
        <a href="{{ basePath }}/products/new" class="btn btn-success">＋ 商品を登録する</a>
      {% endif %}
    </div>
  </div>

  {# 🔍 検索・並び替えフォーム #}
  <form method="GET" action="{{ basePath }}/products" class="mb-4 form-wide">
    <div class="row g-3 align-items-end">
      <div class="col-lg-4">
        <label for="keyword" class="form-label">キーワード検索</label>
        <input type="text" name="keyword" id="keyword" class="form-control"
               placeholder="商品名・コード・カテゴリ"
               value="{{ keyword|default('') }}">
      </div>
      <div class="col-lg-3">
        <label for="sort" class="form-label">並び順</label>
        <select name="sort" id="sort" class="form-select">
          <option value="">選択してください</option>
          {% for value, label in sortOptions %}
            <option value="{{ value }}" {% if selectedSort == value %}selected{% endif %}>{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-lg-2">
        <label for="per_page" class="form-label">表示件数</label>
        <select name="per_page" id="per_page" class="form-select">
          {% for option in [10, 30, 50, 100] %}
            <option value="{{ option }}" {% if selectedPerPage == option %}selected{% endif %}>{{ option }}件</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-lg-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary w-100 btn-wide">検索・並び替え</button>
        <a href="{{ basePath }}/products?sort=code_asc&per_page=10" class="btn btn-outline-secondary w-100 btn-wide">リセット</a>
      </div>
    </div>
  </form>

  <p class="text-muted">全 {{ totalCount }} 件中 {{ products|length }} 件を表示（{{ perPage }}件/ページ）</p>

  {# 📊 商品一覧テーブル（PC表示） #}
  <div class="d-none d-md-block">
    <table class="table table-bordered mt-3">
      <thead class="table-dark">
        <tr>
          <th>画像</th>
          <th>商品コード</th>
          <th>カテゴリ</th>
          <th>商品名</th>
          <th>価格</th>
          <th>仕入価格</th>
          <th>在庫</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        {% if products is empty %}
          <tr><td colspan="8" class="text-center text-muted">該当する商品が見つかりませんでした。</td></tr>
        {% else %}
          {% for product in products %}
            {% set isEven = loop.index0 is even %}
            {% set thumb = product.thumbnail ?? '' %}
            {% set thumbPath = '/images/products/' ~ thumb|url_encode %}
            {% set thumbFile = imageFiles[thumb]|default(null) %}
            <tr class="{% if isEven %}table-light{% else %}table-white{% endif %}">
              <td>
                {% if thumb and thumbFile %}
                  <img src="{{ thumbPath }}" alt="{{ product.name }}" class="thumbnail img-thumbnail" style="max-width: 80px;">
                {% else %}
                  <span class="text-muted">No Image</span>
                {% endif %}
              </td>
              <td>{{ product.code|default('<span class="text-muted">未設定</span>')|raw }}</td>
              <td>{{ product.category_name|default('<span class="text-muted">未分類</span>')|raw }}</td>
              <td>{{ product.name }}</td>
              <td>{{ product.price|default(0)|number_format }} 円</td>
              <td>{{ product.cost_price|default(0)|number_format }} 円</td>
              <td>{{ product.stock|default(0)|number_format }}</td>
              <td>
                {% if macros.canEdit(product, session) %}
                  <div class="d-flex gap-2">
                    <a href="{{ basePath }}/products/{{ product.id }}/edit" class="btn btn-sm btn-outline-primary btn-compact">編集</a>
                    <form method="POST" action="{{ basePath }}/products/{{ product.id }}/delete" onsubmit="return confirm('本当に削除しますか？');">
                      <button type="submit" class="btn btn-sm btn-outline-danger btn-compact">削除</button>
                    </form>
                  </div>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>

  {# 📱 商品一覧カード表示（スマホ用） #}
  <div class="d-md-none px-3">
    {% if products is empty %}
      <p class="text-muted text-center">該当する商品が見つかりませんでした。</p>
    {% else %}
      <div class="row">
        {% for product in products %}
          {% set thumb = product.thumbnail ?? '' %}
          {% set thumbPath = '/images/products/' ~ thumb|url_encode %}
          {% set thumbFile = imageFiles[thumb]|default(null) %}
          <div class="col-12 mb-3">
            <div class="card">
              {% if thumb and thumbFile %}
                <img src="{{ thumbPath }}" alt="{{ product.name }}" class="card-img-top">
              {% else %}
                <div class="card-img-top bg-secondary text-white text-center py-4">No Image</div>
              {% endif %}
              <div class="card-body">
                <h5 class="card-title">{{ product.name }}</h5>
                <p class="card-text">コード: {{ product.code|default('未設定') }}</p>
                <p class="card-text">カテゴリ: {{ product.category_name|default('未分類') }}</p>
                <p class="card-text">価格: {{ product.price|default(0)|number_format }} 円</p>
                <p class="card-text">在庫: {{ product.stock|default(0)|number_format }}</p>
                {% if macros.canEdit(product, session) %}
                  <div class="d-flex gap-2">
                    <a href="{{ basePath }}/products/{{ product.id }}/edit" class="btn btn-sm btn-outline-primary">編集</a>
                    <form method="POST" action="{{ basePath }}/products/{{ product.id }}/delete" onsubmit="return confirm('本当に削除しますか？');">
                      <button type="submit" class="btn btn-sm btn-outline-danger">削除</button>
                    </form>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {# 📄 ページネーション #}
  {% if totalPages > 1 %}
    <nav>
      <ul class="pagination justify-content-center">
        {% for i in 1..totalPages %}
          {% set query = queryString|merge({'page': i}) %}
          <li class="page-item {% if i == currentPage %}active{% endif %}">
            <a class="page-link" href="{{ basePath }}/products?{{ query|url_encode }}">{{ i }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
{% endblock %}