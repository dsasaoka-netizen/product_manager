{% extends "layout.twig" %}

{% block title %}ログイン | 商品管理システム{% endblock %}

{% block content %}
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-6">
      <div class="card shadow-sm">
        <div class="card-header text-center bg-dark text-white py-3">
          <h4 class="mb-0 fs-5">🔒 商品管理システム ログイン</h4>
        </div>
        <div class="card-body">

          {# ✅ セッション切れ・ログアウト・エラー表示 #}
          {% if message %}
            <div class="alert alert-warning text-center">{{ message }}</div>
          {% endif %}

          {% if error is defined and error %}
            <div class="alert alert-danger text-center">{{ error }}</div>
          {% endif %}

          <form method="POST" action="{{ basePath }}/login" enctype="application/x-www-form-urlencoded" novalidate>
            <div class="mb-4">
              <label for="username" class="form-label fs-6">ユーザーID</label>
              <input type="text" name="username" id="username"
                     class="form-control form-control-lg" required
                     inputmode="latin" autocomplete="username" autocapitalize="none"
                     value="{{ username|default('') }}">
            </div>

            <div class="mb-4">
              <label for="password" class="form-label fs-6">パスワード</label>
              <input type="password" name="password" id="password"
                     class="form-control form-control-lg" required
                     inputmode="latin" autocomplete="current-password" autocapitalize="none">
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">ログイン</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
