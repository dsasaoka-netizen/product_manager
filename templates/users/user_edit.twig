{% extends "layouts/admin_layout.twig" %}

{% block title %}ユーザー編集{% endblock %}

{% block content %}
  <div class="container mt-4">
    <h2 class="mb-4">✏️ ユーザー編集</h2>

    {% if error is defined and error %}
      <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    <form action="{{ basePath }}/admin/users/{{ user.id }}/update" method="post">
      <div class="mb-3">
        <label for="username" class="form-label">ユーザー名</label>
        <input type="text" name="username" id="username" class="form-control"
               value="{{ user.username }}" required>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">新しいパスワード（変更しない場合は空欄）</label>
        <input type="password" name="password" id="password" class="form-control">
      </div>

      <div class="mb-3">
        <label for="role" class="form-label">権限</label>
        <select name="role" id="role" class="form-select" required>
          <option value="user" {% if user.role == 'user' %}selected{% endif %}>一般ユーザー</option>
          <option value="admin" {% if user.role == 'admin' %}selected{% endif %}>管理者</option>
        </select>
      </div>

      {% if session.role == 'admin' %}
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" name="can_manage_all_products" id="can_manage_all_products"
                 {% if user.can_manage_all_products %}checked{% endif %}>
          <label class="form-check-label" for="can_manage_all_products">
            他人の商品も編集・削除できる
          </label>
        </div>
      {% endif %}

      <div class="d-grid gap-2 d-md-flex justify-content-md-start mt-4">
        <button type="submit" class="btn btn-primary">更新する</button>
        <a href="{{ basePath }}/admin/users" class="btn btn-outline-secondary">戻る</a>
      </div>
    </form>
  </div>
{% endblock %}
