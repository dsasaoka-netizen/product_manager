{% extends "layouts/admin_layout.twig" %}

{% block title %}サムネイル再生成{% endblock %}

{% block content %}
  <div class="container mt-5">
    <h2>🛠️ サムネイル一括再生成</h2>

    {% if message is defined and message %}
      <div class="alert alert-success mt-3">{{ message }}</div>
    {% endif %}

    <form method="POST">
      <button type="submit" class="btn btn-primary mt-3">再生成を実行する</button>
    </form>

    <a href="{{ basePath }}/admin/dashboard" class="btn btn-link mt-3">← ダッシュボードに戻る</a>
  </div>
{% endblock %}
