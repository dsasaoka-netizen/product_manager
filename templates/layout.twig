<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}商品管理システム{% endblock %}</title>

  {# ✅ Bootstrap CSS #}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  {# ✅ 独自CSS（basePath対応） #}
  <link rel="stylesheet" href="/css/style.css">
  <!-- ✅ layout.twig が読み込まれています -->
</head>
<body>
  <header class="navbar navbar-dark bg-success mb-4">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
      <h1 class="h3 mb-0">商品管理システム</h1>

      {# ✅ ログイン状態に応じた表示制御 #}
      <div class="d-flex align-items-center gap-3">
        {% if session.username is defined %}
          <span class="text-light small">ようこそ、{{ session.username|default('ユーザー') }} さん</span>
          <a href="{{ basePath }}/logout" class="btn btn-sm btn-outline-light">ログアウト</a>
          {% if session.role == 'admin' %}
            <a href="{{ basePath }}/admin/dashboard" class="btn btn-sm btn-outline-warning">管理者画面</a>
          {% endif %}
        {% else %}
          <a href="{{ basePath }}/login" class="btn btn-sm btn-outline-light">ログイン</a>
        {% endif %}
      </div>
    </div>
  </header>

  <main class="container-fluid px-4">
    {% block content %}{% endblock %}
  </main>

  <footer class="bg-light text-center py-3 mt-5">
    <p class="mb-0">&copy; 2025 Yamashichi</p>
  </footer>

  {# ✅ Bootstrap JS #}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
